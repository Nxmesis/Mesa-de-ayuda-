generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  username      String   @unique @db.VarChar(50)
  password      String   @db.VarChar(255)
  area          String?  @db.VarChar(100)
  fotoPerfil    String?  @map("foto_perfil") @db.VarChar(255)
  activo        Boolean  @default(true)
  fechaRegistro DateTime @default(now()) @map("fecha_registro")
  rol           String   @default("usuario") @db.VarChar(50)

  ticketsCreados    Ticket[]     @relation("TicketsCreados")
  ticketsAsignados  Ticket[]     @relation("TicketsAsignados")
  comentarios       Comentario[]
  ordenesEnviadas   Orden[]      @relation("OrdenesEnviadas")
  ordenesRecibidas  Orden[]      @relation("OrdenesRecibidas")

  @@map("usuarios")
}

model Ticket {
  id                 Int               @id @default(autoincrement())
  numeroTicket       String            @unique @map("numero_ticket") @db.VarChar(20)
  titulo             String            @db.VarChar(200)
  descripcion        String            @db.Text
  equipo             String?           @db.VarChar(100)
  prioridad          String            @default("Media") @db.VarChar(20)
  estado             String            @default("Pendiente") @db.VarChar(30)
  solucion           String?           @db.Text
  imagenAdjunta      String?           @map("imagen_adjunta") @db.VarChar(255)
  videoSolucion      String?           @map("video_solucion") @db.VarChar(255)
  imagenSolucion     String?           @map("imagen_solucion") @db.VarChar(255)
  solicitarLlamada   Boolean           @default(false) @map("solicitar_llamada")
  fechaCreacion      DateTime          @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime          @updatedAt @map("fecha_actualizacion")
  fechaCierre        DateTime?         @map("fecha_cierre")

  usuarioId   Int       @map("usuario_id")
  usuario     Usuario   @relation("TicketsCreados", fields: [usuarioId], references: [id])
  tecnicoId   Int?      @map("tecnico_id")
  tecnico     Usuario?  @relation("TicketsAsignados", fields: [tecnicoId], references: [id])
  categoriaId Int?      @map("categoria_id")
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  comentarios Comentario[]

  @@index([categoriaId], map: "tickets_categoria_id_fkey")
  @@index([tecnicoId], map: "tickets_tecnico_id_fkey")
  @@index([usuarioId], map: "tickets_usuario_id_fkey")
  @@map("tickets")
}
 
model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)
  activo      Boolean @default(true)
  tickets     Ticket[]

  @@map("categorias")
}

model Comentario {
  id              Int      @id @default(autoincrement())
  contenido       String   @db.Text
  esInterno       Boolean  @default(false) @map("es_interno")
  archivoAdjunto  String?  @map("archivo_adjunto") @db.VarChar(255)
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion")
  ticketId        Int      @map("ticket_id")
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuarioId       Int      @map("usuario_id")
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "comentarios_ticket_id_fkey")
  @@index([usuarioId], map: "comentarios_usuario_id_fkey")
  @@map("comentarios")
}

model Orden {
  id            Int       @id @default(autoincrement())
  asunto        String    @db.VarChar(200)
  contenido     String    @db.Text
  leido         Boolean   @default(false)
  fechaCreacion DateTime  @default(now()) @map("fecha_creacion")
  fechaLectura  DateTime? @map("fecha_lectura")

  remitenteId    Int     @map("remitente_id")
  remitente      Usuario @relation("OrdenesEnviadas", fields: [remitenteId], references: [id])
  destinatarioId Int     @map("destinatario_id")
  destinatario   Usuario @relation("OrdenesRecibidas", fields: [destinatarioId], references: [id])

  @@index([remitenteId], map: "ordenes_remitente_id_fkey")
  @@index([destinatarioId], map: "ordenes_destinatario_id_fkey")
  @@map("ordenes")
}


model HistorialCambio {
  id              Int       @id @default(autoincrement())
  tablaAfectada   String    @map("tabla_afectada") @db.VarChar(50)
  idRegistro      Int?      @map("id_registro")
  tipoCambio      String    @map("tipo_cambio") @db.VarChar(10)
  campoModificado String?   @map("campo_modificado") @db.VarChar(100)
  valorAnterior   String?   @map("valor_anterior") @db.Text
  valorNuevo      String?   @map("valor_nuevo") @db.Text
  fechaCambio     DateTime? @default(now()) @map("fecha_cambio") @db.DateTime(0)
  usuario         String?   @default("Sistema") @db.VarChar(100)

  @@map("historial_cambios")
}

model Computadora {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(100)
  fabricante    String?  @db.VarChar(100)
  modelo        String?  @db.VarChar(100)
  numeroSerie   String?  @map("numero_serie") @db.VarChar(100)
  procesador    String?  @db.VarChar(100)
  ramGb         Int?     @map("ram_gb")
  discoSsdGb    Int?     @map("disco_ssd_gb")
  estado        String   @default("Operativo") @db.VarChar(30)
  observaciones String?  @db.Text
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Date

  perifericos Periferico[]

  @@map("computadoras")
}

model Periferico {
  id                  Int         @id @default(autoincrement())
  codigo              String      @unique @db.VarChar(20)
  categoria           String      @db.VarChar(50)
  descripcion         String      @db.VarChar(200)
  estado              String      @default("Operativo") @db.VarChar(30)
  observaciones       String?     @db.Text
  computadoraAsignada String?     @map("computadora_asignada") @db.VarChar(100)
  ubicacion           String?     @db.VarChar(100)
  fechaRegistro       DateTime    @default(now()) @map("fecha_registro") @db.Date

  computadora Computadora? @relation(fields: [computadoraAsignada], references: [nombre])

  @@map("perifericos")
}

model Camara {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(20)
  marca         String?  @db.VarChar(100)
  modelo        String?  @db.VarChar(100)
  numeroSerie   String?  @map("numero_serie") @db.VarChar(100)
  ubicacion     String?  @db.VarChar(100)
  piso          String   @default("1") @db.VarChar(10)
  dvr           String   @default("1") @db.VarChar(10)
  ip            String?  @db.VarChar(50)
  estado        String   @default("Operativo") @db.VarChar(30)
  observaciones String?  @db.Text
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Date

  @@map("cameras")
}


model Sensor {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(20)   
  equipo        String   @db.VarChar(100)         
  nomenclatura  String   @db.VarChar(100)          
  ubicacion     String   @db.VarChar(150)          
  tecnologia    String   @default("Cableado") @db.VarChar(30) 
  estado        String   @default("Operativo") @db.VarChar(30)
  observaciones String?  @db.Text
  fechaRegistro DateTime @default(now()) @map("fecha_registro")

  @@map("sensores")
}

model PuntoRed {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(20)  
  ubicacion     String   @db.VarChar(150)          
  tipoCable     String   @default("Cat 5e") @map("tipo_cable") @db.VarChar(30)
  longitud      String?  @db.VarChar(30)          
  tipoUso       String   @default("Datos") @map("tipo_uso") @db.VarChar(30) 
  estado        String   @default("Operativo") @db.VarChar(30)
  observaciones String?  @db.Text
  fechaRegistro DateTime @default(now()) @map("fecha_registro")

  @@map("puntos_red")
}

model EquipoRed {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(20)
  tipoEquipo    String   @map("tipo_equipo") @db.VarChar(30)
  marca         String?  @db.VarChar(100)
  modelo        String?  @db.VarChar(100)
  numeroSerie   String?  @map("numero_serie") @db.VarChar(100)
  ubicacion     String?  @db.VarChar(100)
  ip            String?  @db.VarChar(50)
  estado        String   @default("Operativo") @db.VarChar(30)
  observaciones String?  @db.Text
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Date

  @@map("equipos_red")
}

model DocumentoInventario {
  id             Int      @id @default(autoincrement())
  titulo         String   @db.VarChar(150)         
  empresa        String   @db.VarChar(150)          
  tipoDocumento  String   @default("Acta") @map("tipo_documento") @db.VarChar(30) 
  categoria      String   @default("General") @db.VarChar(30) 
  archivo        String   @db.VarChar(255)          
  fechaDocumento DateTime? @map("fecha_documento") @db.Date
  observaciones  String?  @db.Text
  fechaSubida    DateTime @default(now()) @map("fecha_subida")

  @@map("documentos_inventario")
}

model Mantenimiento {
  id              Int       @id @default(autoincrement())
  equipoId        Int       @map("equipo_id")
  equipoTipo      String    @map("equipo_tipo") @db.VarChar(30)   
  tipo            String    @default("Preventivo") @db.VarChar(20) 
  estado          String    @default("Pendiente") @db.VarChar(20)  
  responsable     String?   @db.VarChar(100)
  fechaProgramada DateTime  @map("fecha_programada") @db.Date
  fechaRealizada  DateTime? @map("fecha_realizada") @db.Date
  proximaFecha    DateTime? @map("proxima_fecha") @db.Date
  horaInicio      String?   @map("hora_inicio") @db.VarChar(5)     
  horaFin         String?   @map("hora_fin") @db.VarChar(5)       
  tiempoInvertido Int?      @map("tiempo_invertido")               
  descripcion     String?   @db.Text
  repuestos       String?   @db.Text
  observaciones   String?   @db.Text
  evidencias      String?   @db.Text                              
  fotoEvidencia   String?   @map("foto_evidencia") @db.VarChar(255) 
  frecuencia      String?   @db.VarChar(20)                        
  fechaRegistro   DateTime  @default(now()) @map("fecha_registro")

  @@index([equipoId, equipoTipo])
  @@index([estado])
  @@index([fechaProgramada])
  @@index([proximaFecha])
  @@map("mantenimientos")
}

model EquipoMantenimiento {
  id                  Int       @id @default(autoincrement())
  equipoId            Int       @map("equipo_id")
  equipoTipo          String    @map("equipo_tipo") @db.VarChar(30)
  frecuencia          String    @default("Mensual") @db.VarChar(20)
  ultimoMantenimiento DateTime? @map("ultimo_mantenimiento") @db.Date
  proximoMantenimiento DateTime? @map("proximo_mantenimiento") @db.Date
  activo              Boolean   @default(true)
  fechaRegistro       DateTime  @default(now()) @map("fecha_registro")

  @@unique([equipoId, equipoTipo])
  @@index([proximoMantenimiento])
  @@map("equipos_mantenimiento")
}

enum tickets_prioridad {
  Baja
  Media
  Alta
  Critica
}