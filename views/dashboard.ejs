<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<div class="main-content">
  <%- include('partials/navbar') %>

  <div class="container">
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error[0] %></div>
    <% } %>

    <% if (user.rol === 'admin' || user.rol === 'tecnico') { %>

    <%# ===== MODO HISTORIAL: Banner ===== %>
    <% if (typeof modoHistorial !== 'undefined' && modoHistorial) { %>
    <div class="dash-historial-banner">
      <div class="dash-historial-info">
        <i class="fas fa-history"></i>
        <span>Viendo historial: <strong><%= tituloFecha %></strong></span>
      </div>
      <a href="/dashboard" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-arrow-left"></i> Volver
      </a>
    </div>
    <% } %>

    <%# ═══════ HEADER DASHBOARD ═══════ %>
    <div class="dash-header">
      <div class="dash-title-group">
        <h1 class="dash-title">Dashboard</h1>
        <p class="dash-subtitle">Panel de control y análisis de rendimiento del sistema</p>
      </div>

      <div class="dash-actions">
        <%# Período %>
        <div class="dash-periodo-badge">
          <span class="dash-periodo-label">Período</span>
          <div class="dash-periodo-valor">
            <i class="far fa-calendar-alt"></i>
            <%= tituloFecha %>
          </div>
        </div>

        <%# Botón Exportar con dropdown %>
        <div class="dash-export-dropdown">
          <button type="button" class="dash-export-btn" id="btn-exportar-toggle">
            <i class="fas fa-arrow-up"></i>
            <span>Exportar</span>
            <i class="fas fa-chevron-down" style="margin-left:6px; font-size:0.7rem;"></i>
          </button>
          <div class="dash-export-menu" id="exportar-menu">
            <a href="/estadisticas/reporte" class="dash-export-item">
              <i class="fas fa-file-pdf"></i>
              <span>Período actual</span>
            </a>
            <button type="button" class="dash-export-item" onclick="abrirModalExportar()">
              <i class="fas fa-calendar-alt"></i>
              <span>Seleccionar período...</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# ═══════ KPI CARDS ═══════ %>
    <div class="dash-kpi-grid">

      <div class="dash-kpi-card total">
        <div class="dash-kpi-top">
          <div class="dash-kpi-icon">
            <i class="fas fa-ticket-alt"></i>
          </div>
          <span class="dash-kpi-badge">+<%= stats.estemes || 0 %> este mes</span>
        </div>
        <div class="dash-kpi-number"><%= stats.total || 0 %></div>
        <div class="dash-kpi-label">Total Tickets</div>
      </div>

      <div class="dash-kpi-card pendientes">
        <div class="dash-kpi-top">
          <div class="dash-kpi-icon">
            <i class="fas fa-clock"></i>
          </div>
        </div>
        <div class="dash-kpi-number"><%= stats.pendientes || 0 %></div>
        <div class="dash-kpi-label">Pendientes</div>
      </div>

      <div class="dash-kpi-card proceso">
        <div class="dash-kpi-top">
          <div class="dash-kpi-icon">
            <i class="fas fa-spinner"></i>
          </div>
        </div>
        <div class="dash-kpi-number"><%= stats.enProceso || 0 %></div>
        <div class="dash-kpi-label">En Proceso</div>
      </div>

      <div class="dash-kpi-card solucionados">
        <div class="dash-kpi-top">
          <div class="dash-kpi-icon">
            <i class="fas fa-check-circle"></i>
          </div>
        </div>
        <div class="dash-kpi-number"><%= stats.solucionados || 0 %></div>
        <div class="dash-kpi-label">Solucionados</div>
      </div>

      <div class="dash-kpi-card cerrados">
        <div class="dash-kpi-top">
          <div class="dash-kpi-icon">
            <i class="fas fa-lock"></i>
          </div>
        </div>
        <div class="dash-kpi-number"><%= stats.cerrados || 0 %></div>
        <div class="dash-kpi-label">Cerrados</div>
      </div>

      <div class="dash-kpi-card tasa">
        <div class="dash-kpi-top">
          <div class="dash-kpi-icon">
            <i class="fas fa-percentage"></i>
          </div>
        </div>
        <div class="dash-kpi-number">
          <%= stats.total > 0 ? Math.round((stats.solucionados + stats.cerrados) * 100 / stats.total) : 0 %>%
        </div>
        <div class="dash-kpi-label">Tasa de Resolución</div>
      </div>
    </div>

    <%# ═══════ TICKETS RECIENTES (SCROLLABLE) ═══════ %>
    <div class="dash-section">
      <div class="dash-section-header">
        <div>
          <h2 class="dash-section-title">
            <% if (typeof modoHistorial !== 'undefined' && modoHistorial) { %>
              Tickets - <%= tituloFecha %>
            <% } else { %>
              Tickets Recientes
            <% } %>
          </h2>
        </div>
        <div class="dash-section-actions">
          <% if (typeof modoHistorial === 'undefined' || !modoHistorial) { %>
          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="abrirModalHistorial()">
            <i class="fas fa-calendar-alt"></i> Historial
          </button>
          <% } %>
          <a href="/tickets/nuevo" class="btn btn-success btn-sm">Nuevo Ticket</a>
        </div>
      </div>

      <div class="dash-scroll-container">
        <table class="table table-compact">
          <thead>
            <tr>
              <th>N° Ticket</th>
              <th>Título</th>
              <th>Solicitante</th>
              <th>Área</th>
              <th>Categoría</th>
              <th>Prioridad</th>
              <th>Estado</th>
              <th>Asignación</th>
              <th>Fecha</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof tickets !== 'undefined' && tickets && tickets.length > 0) { %>
            <% tickets.forEach(ticket => { %>
            <tr>
              <td><strong><%= ticket.numeroTicket %></strong></td>
              <td><%= ticket.titulo && ticket.titulo.length > 35 ? ticket.titulo.substring(0,35)+'...' : ticket.titulo %></td>
              <td><%= ticket.usuario && ticket.usuario.nombre || 'N/A' %></td>
              <td><%= ticket.usuario && ticket.usuario.area || 'N/A' %></td>
              <td><%= ticket.categoria && ticket.categoria.nombre || '—' %></td>
              <td><span class="badge <%= helpers.getPrioridadClass(ticket.prioridad) %>"><%= ticket.prioridad %></span></td>
              <td><span class="badge <%= helpers.getEstadoClass(ticket.estado) %>"><%= helpers.textoEstado(ticket.estado) %></span></td>
              <td><%= ticket.tecnico && ticket.tecnico.nombre || '—' %></td>
              <td><%= helpers.formatearFecha(ticket.fechaCreacion) %></td>
              <td><a href="/tickets/<%= ticket.id %>" class="btn btn-primary btn-sm">Ver</a></td>
            </tr>
            <% }) %>
            <% } else { %>
            <tr>
              <td colspan="10" class="text-center" style="padding:30px; color:#94a3b8;">
                <%= (typeof modoHistorial !== 'undefined' && modoHistorial) ? 'No hay tickets en este período' : 'No hay tickets registrados este mes' %>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <%# ═══════ GRÁFICOS ═══════ %>
    <div class="dash-charts-grid">

      <%# Tendencia %>
      <div class="dash-chart-card">
        <div class="dash-chart-header">
          <h3><i class="fas fa-chart-area"></i> Tendencia de Tickets</h3>
          <p class="dash-chart-subtitle">Evolución de tickets en los últimos 7 días</p>
        </div>
        <div class="dash-chart-body">
          <canvas id="tendenciaChart" 
                  data-dias='<%- JSON.stringify(diasLabels || ["Lun","Mar","Mié","Jue","Vie","Sáb","Dom"]) %>'
                  data-valores='<%- JSON.stringify(porDia || [0,0,0,0,0,0,0]) %>'></canvas>
        </div>
      </div>

      <%# Distribución (doughnut) %>
      <div class="dash-chart-card dash-chart-small">
        <div class="dash-chart-header">
          <h3><i class="fas fa-chart-pie"></i> Distribución</h3>
          <p class="dash-chart-subtitle">Tickets por estado</p>
        </div>
        <div class="dash-chart-body">
          <canvas id="estadoChart"
                  data-valores='<%- JSON.stringify([stats.pendientes||0, stats.enProceso||0, stats.solucionados||0, stats.cerrados||0]) %>'></canvas>
        </div>
      </div>
    </div>

    <div class="dash-charts-grid">

      <%# Categoría - colores específicos %>
      <div class="dash-chart-card">
        <div class="dash-chart-header">
          <h3><i class="fas fa-tags"></i> Tickets por Categoría</h3>
        </div>
        <div class="dash-chart-body">
          <canvas id="categoriaChart"
                  data-labels='<%- JSON.stringify((porCategoria||[]).map(c=>c.nombre)) %>'
                  data-valores='<%- JSON.stringify((porCategoria||[]).map(c=>c._count.tickets)) %>'
                  data-colors='<%- JSON.stringify((porCategoria||[]).map(c => CATEGORIA_COLORS[c.nombre] || '#94a3b8')) %>'></canvas>
        </div>
      </div>

      <%# Prioridad - colores específicos %>
      <div class="dash-chart-card">
        <div class="dash-chart-header">
          <h3><i class="fas fa-exclamation-triangle"></i> Tickets por Prioridad</h3>
        </div>
        <div class="dash-chart-body">
          <canvas id="prioridadChart"
                  data-labels='<%- JSON.stringify((porPrioridad||[]).map(p=>p.prioridad)) %>'
                  data-valores='<%- JSON.stringify((porPrioridad||[]).map(p=>p._count.id)) %>'
                  data-colors='<%- JSON.stringify((porPrioridad||[]).map(p => PRIORIDAD_COLORS[p.prioridad] || '#94a3b8')) %>'></canvas>
        </div>
      </div>
    </div>

    <% } else { %>
    <%# ===== VISTA USUARIO NORMAL ===== %>
    <div class="dash-user-header">
      <h1>Mis Solicitudes</h1>
      <a href="/tickets/nuevo" class="btn btn-success">Crear Nueva Solicitud</a>
    </div>
    <div class="card">
      <div class="card-header">Historial de Tickets</div>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>N° Ticket</th><th>Título</th><th>Categoría</th>
              <th>Prioridad</th><th>Estado</th><th>Fecha</th><th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof tickets !== 'undefined' && tickets && tickets.length > 0) { %>
            <% tickets.forEach(ticket => { %>
            <tr>
              <td><strong><%= ticket.numeroTicket %></strong></td>
              <td><%= ticket.titulo && ticket.titulo.length > 50 ? ticket.titulo.substring(0,50)+'...' : ticket.titulo %></td>
              <td><%= ticket.categoria && ticket.categoria.nombre || '—' %></td>
              <td><span class="badge <%= helpers.getPrioridadClass(ticket.prioridad) %>"><%= ticket.prioridad %></span></td>
              <td><span class="badge <%= helpers.getEstadoClass(ticket.estado) %>"><%= helpers.textoEstado(ticket.estado) %></span></td>
              <td><%= helpers.formatearFecha(ticket.fechaCreacion) %></td>
              <td><a href="/tickets/<%= ticket.id %>" class="btn btn-primary btn-sm">Ver</a></td>
            </tr>
            <% }) %>
            <% } else { %>
            <tr><td colspan="7" style="text-align:center;padding:20px">No tienes tickets registrados</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>

  <%# ═══════ MODAL HISTORIAL ═══════ %>
  <div id="modal-historial" class="dash-modal-overlay">
    <div class="dash-modal-content">
      <div class="dash-modal-header">
        <h3><i class="fas fa-calendar-alt"></i> Consultar Historial</h3>
        <button type="button" class="dash-modal-close" onclick="cerrarModalHistorial()">&times;</button>
      </div>
      <div class="dash-modal-body">
        <div class="form-group">
          <label for="select-mes">Seleccionar mes:</label>
          <input type="month" id="select-mes" class="form-control">
        </div>
        <div class="form-group">
          <label for="select-dia">Filtrar por día específico (opcional):</label>
          <input type="date" id="select-dia" class="form-control">
          <small>Dejar vacío para ver todo el mes</small>
        </div>
      </div>
      <div class="dash-modal-footer">
        <button type="button" class="btn btn-secondary" onclick="cerrarModalHistorial()">Cancelar</button>
        <button type="button" class="btn btn-primary" onclick="consultarHistorial()">
          <i class="fas fa-search"></i> Consultar
        </button>
      </div>
    </div>
  </div>

  <%# ═══════ MODAL EXPORTAR ═══════ %>
  <div id="modal-exportar" class="dash-modal-overlay">
    <div class="dash-modal-content">
      <div class="dash-modal-header">
        <h3><i class="fas fa-file-pdf"></i> Exportar Reporte</h3>
        <button type="button" class="dash-modal-close" onclick="cerrarModalExportar()">&times;</button>
      </div>
      <div class="dash-modal-body">
        <div class="form-group">
          <label for="export-mes">Seleccionar mes del reporte:</label>
          <input type="month" id="export-mes" class="form-control">
        </div>
        <div class="form-group">
          <label for="export-dia">O filtrar por día específico (opcional):</label>
          <input type="date" id="export-dia" class="form-control">
          <small>Dejar vacío para exportar todo el mes</small>
        </div>
      </div>
      <div class="dash-modal-footer">
        <button type="button" class="btn btn-secondary" onclick="cerrarModalExportar()">Cancelar</button>
        <button type="button" class="btn btn-primary" onclick="exportarReporte()">
          <i class="fas fa-file-pdf"></i> Generar PDF
        </button>
      </div>
    </div>
  </div>

</div>