<% if (typeof user !== 'undefined' && user && user.id) { %>
<nav class="navbar">
    <div class="nav-container">
        <div class="nav-brand">
            <a href="<%= user.rol === 'admin' || user.rol === 'tecnico' ? '/dashboard' : '/tickets' %>">
                <img src="/img/logo.jpeg" alt="Almacén El Melao" class="nav-logo">
                <span class="nav-brand-text">Mesa de Ayuda</span>
            </a>
        </div>
        <div class="nav-user">
            <div class="notificaciones-wrapper" id="notificaciones-wrapper">
                <button class="notificaciones-btn" id="notificaciones-btn" type="button" aria-label="Notificaciones" title="Notificaciones">
                    <i class="fas fa-bell"></i>
                    <span class="notificaciones-badge" id="notificaciones-badge" style="display:none;">0</span>
                </button>
                <div class="notificaciones-dropdown" id="notificaciones-dropdown">
                    <div class="notificaciones-header">
                        <span>Notificaciones</span>
                        <button class="notificaciones-marcar-leidas" id="notificaciones-marcar-leidas" type="button">Marcar todo como leído</button>
                    </div>
                    <div class="notificaciones-lista" id="notificaciones-lista">
                        <div class="notificaciones-vacio">No hay notificaciones</div>
                    </div>
                </div>
            </div>
            <span class="nav-user-name"><%= user.nombre %></span>
            <span class="nav-user-badge"><%= helpers.nombreRol(user.rol) %></span>
        </div>
    </div>
</nav>
<% } %>