<% if (typeof user !== 'undefined' && user && user.id) { %>
<aside class="sidebar" id="sidebar">

  <div class="sidebar-header">
    <a href="/perfil" class="sidebar-profile-link">
      <% if (user.fotoPerfil) { %>
        <img src="/uploads/perfiles/<%= user.fotoPerfil %>" alt="Foto de perfil" class="sidebar-foto">
      <% } else { %>
        <div class="sidebar-avatar-grande">
          <%= user.nombre.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <div class="sidebar-profile-info">
        <div class="sidebar-user-name"><%= user.nombre %></div>
        <div class="sidebar-user-role"><%= user.rol %></div>
      </div>
    </a>
  </div>

  <nav class="sidebar-nav">

    <% if (user.rol === 'admin' || user.rol === 'tecnico') { %>
    <a href="/dashboard" class="sidebar-link <%= title === 'Dashboard' || (title && title.startsWith('Historial')) ? 'active' : '' %>">
      <i class="fas fa-chart-line"></i>
      <span>Dashboard</span>
    </a>
    <% } %>

    <a href="/tickets/nuevo" class="sidebar-link <%= title === 'Crear Ticket' ? 'active' : '' %>">
      <i class="fas fa-plus-circle"></i>
      <span>Nueva Solicitud</span>
    </a>

    <a href="/tickets" class="sidebar-link <%= title === 'Tickets' ? 'active' : '' %>">
      <i class="fas fa-ticket-alt"></i>
      <span>Mis Solicitudes</span>
    </a>

    <a href="/ordenes" class="sidebar-link <%= (title === 'Ordenes' || title === 'Nueva Orden' || title === 'Orden') ? 'active' : '' %>">
      <i class="fas fa-clipboard-list"></i>
      <span>Ordenes</span>
    </a>

    <% if (user.rol === 'admin' || user.rol === 'tecnico') { %>
    <div class="sidebar-section">Administración</div>

    <a href="/usuarios" class="sidebar-link <%= title === 'Gestion de Usuarios' ? 'active' : '' %>">
      <i class="fas fa-users"></i>
      <span>Usuarios</span>
    </a>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- INVENTARIO CON SUBMENÚ                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <% const inventarioActivo = (title === 'Inventario de Equipos' || title === 'Mantenimientos' || title === 'Dashboard de Mantenimientos'); %>
    <div class="sidebar-group <%= inventarioActivo ? 'expanded' : '' %>">
      <a href="/inventario" 
         class="sidebar-link <%= title === 'Inventario de Equipos' ? 'active' : '' %>"
         onclick="if(event.target.closest('.sidebar-toggle')){event.preventDefault();toggleSubmenu(this);}">
        <i class="fas fa-boxes"></i>
        <span>Inventario</span>
        <button type="button" class="sidebar-toggle" onclick="event.preventDefault();event.stopPropagation();toggleSubmenu(this);" aria-label="Expandir submenu">
          <i class="fas fa-chevron-down sidebar-chevron <%= inventarioActivo ? 'rotated' : '' %>"></i>
        </button>
      </a>
      <div class="sidebar-submenu" id="submenu-inventario" style="<%= inventarioActivo ? 'display:block;' : 'display:none;' %>">
        <a href="/inventario" class="sidebar-sublink <%= title === 'Inventario de Equipos' ? 'active' : '' %>">
          <i class="fas fa-desktop"></i> Equipos
        </a>
        <a href="/inventario/mantenimientos" class="sidebar-sublink <%= title === 'Mantenimientos' ? 'active' : '' %>">
          <i class="fas fa-tools"></i> Mantenimientos
        </a>
        <a href="/inventario/mantenimientos/dashboard" class="sidebar-sublink <%= title === 'Dashboard de Mantenimientos' ? 'active' : '' %>">
          <i class="fas fa-chart-pie"></i> Dashboard
        </a>
      </div>
    </div>
    <% } %>

    <div class="sidebar-section">Cuenta</div>

    <a href="/perfil" class="sidebar-link <%= title === 'Mi Perfil' ? 'active' : '' %>">
      <i class="fas fa-user-circle"></i>
      <span>Mi Perfil</span>
    </a>

    <form action="/logout" method="POST" class="sidebar-logout-form">
      <button type="submit" class="sidebar-link sidebar-logout-btn">
        <i class="fas fa-sign-out-alt"></i>
        <span>Cerrar Sesión</span>
      </button>
    </form>

  </nav>

</aside>

<script>
function toggleSubmenu(btn) {
    const group = btn.closest('.sidebar-group');
    const submenu = group.querySelector('.sidebar-submenu');
    const chevron = group.querySelector('.sidebar-chevron');
    const isExpanded = submenu.style.display === 'block';

    submenu.style.display = isExpanded ? 'none' : 'block';
    chevron.classList.toggle('rotated', !isExpanded);
    group.classList.toggle('expanded', !isExpanded);
}
</script>
<% } %>