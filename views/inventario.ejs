<%- include('partials/head') %>
<%- include('partials/sidebar') %>

<div class="main-content">
    <%- include('partials/navbar') %>

    <div class="container">
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <div class="alert alert-success"><%= success[0] %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <div class="alert alert-danger"><%= error[0] %></div>
        <% } %>

        <h1 style="color:#2d3748; margin-bottom:20px;">Inventario de Equipos</h1>

        <div class="inventario-layout">

            <!-- ═══════════════════════════════════════════════ -->
            <!-- MENÚ LATERAL DE CATEGORÍAS                       -->
            <!-- ═══════════════════════════════════════════════ -->
            <div class="inventario-nav">
                <button type="button" class="inventario-nav-item <%= tab === 'computadoras' ? 'active' : '' %>" data-tab="computadoras" onclick="mostrarTab('computadoras', this)">
                    <i class="fas fa-desktop"></i>
                    <span>Computadoras</span>
                    <span class="inventario-nav-count"><%= counts.pcs %></span>
                </button>
                <button type="button" class="inventario-nav-item <%= tab === 'perifericos' ? 'active' : '' %>" data-tab="perifericos" onclick="mostrarTab('perifericos', this)">
                    <i class="fas fa-keyboard"></i>
                    <span>Periféricos</span>
                    <span class="inventario-nav-count"><%= counts.perifericos %></span>
                </button>
                <button type="button" class="inventario-nav-item <%= tab === 'camaras' ? 'active' : '' %>" data-tab="camaras" onclick="mostrarTab('camaras', this)">
                    <i class="fas fa-video"></i>
                    <span>Cámaras</span>
                    <span class="inventario-nav-count"><%= counts.camaras %></span>
                </button>
                <button type="button" class="inventario-nav-item <%= tab === 'sensores' ? 'active' : '' %>" data-tab="sensores" onclick="mostrarTab('sensores', this)">
                    <i class="fas fa-shield-alt"></i>
                    <span>Sensores</span>
                    <span class="inventario-nav-count"><%= counts.sensores %></span>
                </button>
                <button type="button" class="inventario-nav-item <%= tab === 'puntosred' ? 'active' : '' %>" data-tab="puntosred" onclick="mostrarTab('puntosred', this)">
                    <i class="fas fa-network-wired"></i>
                    <span>Puntos de Red</span>
                    <span class="inventario-nav-count"><%= counts.puntosred %></span>
                </button>
                <div class="inventario-nav-divider"></div>
                <button type="button" class="inventario-nav-item <%= tab === 'archivados' ? 'active' : '' %>" data-tab="archivados" onclick="mostrarTab('archivados', this)">
                    <i class="fas fa-archive"></i>
                    <span>Archivados</span>
                    <span class="inventario-nav-count"><%= counts.archivados %></span>
                </button>
                <button type="button" class="inventario-nav-item <%= tab === 'documentos' ? 'active' : '' %>" data-tab="documentos" onclick="mostrarTab('documentos', this)">
                    <i class="fas fa-file-alt"></i>
                    <span>Documentos</span>
                    <span class="inventario-nav-count"><%= counts.documentos %></span>
                </button>
            </div>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- CONTENIDO                                        -->
            <!-- ═══════════════════════════════════════════════ -->
            <div class="inventario-content">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PANEL COMPUTADORAS                                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="tab-computadoras" class="inventario-panel <%= tab === 'computadoras' ? 'active' : '' %>">
            <div class="excel-toolbar">
                <div class="excel-search">
                    <input type="text" id="buscar-computadoras"
                           placeholder="Buscar computadoras..."
                           onkeyup="filtrarTabla('tabla-computadoras', this.value)">
                </div>
                <button class="btn btn-success" onclick="abrirModal('modal-computadora')">
                    + Nueva Computadora
                </button>
            </div>

            <div class="card" style="padding:0;">
                <div class="table-container">
                    <table class="table" id="tabla-computadoras">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Fabricante</th>
                                <th>Modelo</th>
                                <th>Procesador</th>
                                <th>RAM</th>
                                <th>Disco</th>
                                <th>Estado</th>
                                <th>Observaciones</th>
                                <th style="width:90px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (computadoras && computadoras.length > 0) { %>
                            <% computadoras.forEach(pc => { %>
                            <tr>
                                <td><strong><%= pc.nombre %></strong></td>
                                <td><%= pc.fabricante || '—' %></td>
                                <td><%= pc.modelo || '—' %></td>
                                <td><%= pc.procesador || '—' %></td>
                                <td><%= pc.ramGb ? pc.ramGb + ' GB' : '—' %></td>
                                <td><%= pc.discoSsdGb ? pc.discoSsdGb + ' GB' : '—' %></td>
                                <td>
                                    <span class="badge <%= pc.estado === 'Operativo' ? 'badge-success' : pc.estado === 'Averiado' ? 'badge-danger' : pc.estado === 'Deficiente' ? 'badge-warning' : pc.estado === 'Pendiente revisión' ? 'badge-info' : 'badge-secondary' %>">
                                        <%= pc.estado %>
                                    </span>
                                </td>
                                <td><%= pc.observaciones || '—' %></td>
                                <td>
                                    <div class="excel-actions">
                                        <button type="button" class="excel-btn excel-btn-save"
                                                onclick="editarComputadora(<%= pc.id %>)" title="Editar">✏️</button>
                                        <button type="button" class="excel-btn excel-btn-delete"
                                                onclick="confirmarEliminar('/inventario/computadoras/<%= pc.id %>/eliminar')"
                                                title="Eliminar">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                            <tr id="edit-pc-<%= pc.id %>" style="display:none; background:#fffbeb;">
                                <td colspan="9" style="padding:0;">
                                    <form action="/inventario/computadoras/<%= pc.id %>/editar" method="POST"
                                          style="display:table; width:100%;">
                                        <div style="display:table-row;">
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <input type="text" value="<%= pc.nombre %>" class="excel-cell-input" readonly>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:11%;">
                                                <input type="text" name="fabricante" value="<%= pc.fabricante || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:11%;">
                                                <input type="text" name="modelo" value="<%= pc.modelo || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:14%;">
                                                <input type="text" name="procesador" value="<%= pc.procesador || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:8%;">
                                                <input type="number" name="ramGb" value="<%= pc.ramGb || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:8%;">
                                                <input type="number" name="discoSsdGb" value="<%= pc.discoSsdGb || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <select name="estado" class="excel-cell-select" onchange="validarArchivado(this, 'computadora', <%= pc.id %>)">
                                                    <% estados.forEach(e => { %>
                                                        <option value="<%= e %>" <%= pc.estado === e ? 'selected' : '' %>><%= e %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:14%;">
                                                <input type="text" name="observaciones" value="<%= pc.observaciones || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <div class="excel-actions">
                                                    <button type="submit" class="excel-btn excel-btn-save" title="Guardar">✓</button>
                                                    <button type="button" class="excel-btn excel-btn-delete"
                                                            onclick="cancelarEdicion('edit-pc-<%= pc.id %>')" title="Cancelar">✕</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="9" style="text-align:center; padding:40px; color:#a0aec0;">No hay computadoras registradas</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PANEL PERIFÉRICOS                                   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="tab-perifericos" class="inventario-panel <%= tab === 'perifericos' ? 'active' : '' %>">
            <div class="excel-toolbar">
                <div class="excel-search">
                    <input type="text" id="buscar-perifericos"
                           placeholder="Buscar periféricos..."
                           onkeyup="filtrarTabla('tabla-perifericos', this.value)">
                </div>
                <button class="btn btn-success" onclick="abrirModal('modal-periferico')">
                    + Nuevo Periférico
                </button>
            </div>

            <div class="card" style="padding:0;">
                <div class="table-container">
                    <table class="table" id="tabla-perifericos">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Categoría</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Asignado a</th>
                                <th>Ubicación</th>
                                <th>Observaciones</th>
                                <th style="width:90px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (perifericos && perifericos.length > 0) { %>
                            <% perifericos.forEach(per => { %>
                            <tr>
                                <td><strong><%= per.codigo %></strong></td>
                                <td><%= per.categoria %></td>
                                <td><%= per.descripcion %></td>
                                <td>
                                    <span class="badge <%= per.estado === 'Operativo' ? 'badge-success' : per.estado === 'Averiado' ? 'badge-danger' : per.estado === 'Deficiente' ? 'badge-warning' : per.estado === 'Pendiente revisión' ? 'badge-info' : 'badge-secondary' %>">
                                        <%= per.estado %>
                                    </span>
                                </td>
                                <td><%= per.computadoraAsignada || 'Sin asignar' %></td>
                                <td><%= per.ubicacion || '—' %></td>
                                <td><%= per.observaciones || '—' %></td>
                                <td>
                                    <div class="excel-actions">
                                        <button type="button" class="excel-btn excel-btn-save"
                                                onclick="editarPeriferico(<%= per.id %>)" title="Editar">✏️</button>
                                        <button type="button" class="excel-btn excel-btn-delete"
                                                onclick="confirmarEliminar('/inventario/perifericos/<%= per.id %>/eliminar')"
                                                title="Eliminar">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                            <tr id="edit-per-<%= per.id %>" style="display:none; background:#fffbeb;">
                                <td colspan="8" style="padding:0;">
                                    <form action="/inventario/perifericos/<%= per.id %>/editar" method="POST"
                                          style="display:table; width:100%;">
                                        <div style="display:table-row;">
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <input type="text" name="codigo" value="<%= per.codigo %>" class="excel-cell-input" readonly>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <select name="categoria" class="excel-cell-select">
                                                    <% ['Teclado','Mouse','Monitor','UPS','Scanner','Impresora','Servidor','Red','Otro'].forEach(c => { %>
                                                        <option value="<%= c %>" <%= per.categoria === c ? 'selected' : '' %>><%= c %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:18%;">
                                                <input type="text" name="descripcion" value="<%= per.descripcion %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <select name="estado" class="excel-cell-select" onchange="validarArchivado(this, 'periferico', <%= per.id %>)">
                                                    <% estados.forEach(e => { %>
                                                        <option value="<%= e %>" <%= per.estado === e ? 'selected' : '' %>><%= e %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:14%;">
                                                <select name="computadoraAsignada" class="excel-cell-select">
                                                    <option value="">-- Sin asignar --</option>
                                                    <% listaComputadoras.forEach(pc => { %>
                                                        <option value="<%= pc.nombre %>" <%= per.computadoraAsignada === pc.nombre ? 'selected' : '' %>><%= pc.nombre %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <input type="text" name="ubicacion" value="<%= per.ubicacion || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:16%;">
                                                <input type="text" name="observaciones" value="<%= per.observaciones || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <div class="excel-actions">
                                                    <button type="submit" class="excel-btn excel-btn-save" title="Guardar">✓</button>
                                                    <button type="button" class="excel-btn excel-btn-delete"
                                                            onclick="cancelarEdicion('edit-per-<%= per.id %>')" title="Cancelar">✕</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="8" style="text-align:center; padding:40px; color:#a0aec0;">No hay periféricos registrados</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PANEL CÁMARAS                                       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="tab-camaras" class="inventario-panel <%= tab === 'camaras' ? 'active' : '' %>">

            <!-- Sub-tabs de pisos -->
            <div class="piso-tabs" style="display:flex; gap:8px; margin-bottom:20px; padding:0 0 10px 0; border-bottom:2px solid #e2e8f0; flex-wrap:wrap;">
                <% pisos.forEach((p, i) => { %>
                    <button type="button"
                       class="piso-tab <%= piso === p ? 'active' : '' %>" data-piso="<%= p %>"
                       onclick="mostrarPisoCamara('<%= p %>', this)"
                       style="display:flex; align-items:center; gap:8px; padding:10px 20px; border-radius:8px; border:none; cursor:pointer; font-weight:600; font-size:0.9rem; font-family:inherit; transition:all 0.2s; <%= piso === p ? 'background:linear-gradient(135deg, #2ecc71, #27ae60); color:white; box-shadow:0 2px 8px rgba(46,204,113,0.3);' : 'background:#f8fafc; color:#64748b;' %>">
                        <i class="fas fa-building" style="font-size:0.85rem;"></i>
                        Piso <%= p %>
                        <span class="piso-tab-count" style="background:<%= piso === p ? 'rgba(255,255,255,0.25)' : '#e2e8f0' %>; color:<%= piso === p ? 'white' : '#64748b' %>; padding:2px 10px; border-radius:12px; font-size:0.75rem; font-weight:700;">
                            <%= camarasPorPiso[p] || 0 %>
                        </span>
                    </button>
                <% }) %>
            </div>

            <div class="excel-toolbar">
                <div class="excel-search">
                    <input type="text" id="buscar-camaras"
                           placeholder="Buscar cámaras..."
                           onkeyup="filtrarTablaCamaras(this.value)">
                </div>
                <button class="btn btn-success" id="btn-nueva-camara" onclick="abrirModalCamara(currentPisoCamara)">
                    + Nueva Cámara (Piso <%= piso %>)
                </button>
            </div>

            <% ['1','2','3'].forEach((p, i) => { %>
            <div class="camara-piso-panel <%= piso === p ? 'active' : '' %>" id="camaras-piso-<%= p %>">
                <div class="card" style="padding:0;">
                    <div class="table-container">
                        <table class="table" id="tabla-camaras-<%= p %>">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Marca</th>
                                    <th>DVR</th>
                                    <th>Ubicación</th>
                                    <th>Estado</th>
                                    <th>Observaciones</th>
                                    <th style="width:90px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% const listaCam = camarasPorPisoLista[p] %>
                                <% if (listaCam && listaCam.length > 0) { %>
                                <% listaCam.forEach(cam => { %>
                                <tr>
                                    <td><strong><%= cam.codigo %></strong></td>
                                    <td><%= cam.marca || '—' %></td>
                                    <td><%= cam.dvr || '—' %></td>
                                    <td><%= cam.ubicacion || '—' %></td>
                                    <td>
                                        <span class="badge <%= cam.estado === 'Operativo' ? 'badge-success' : cam.estado === 'Averiado' ? 'badge-danger' : cam.estado === 'Deficiente' ? 'badge-warning' : cam.estado === 'Pendiente revisión' ? 'badge-info' : 'badge-secondary' %>">
                                            <%= cam.estado %>
                                        </span>
                                    </td>
                                    <td><%= cam.observaciones || '—' %></td>
                                    <td>
                                        <div class="excel-actions">
                                            <button type="button" class="excel-btn excel-btn-save"
                                                    onclick="editarCamara(<%= cam.id %>)" title="Editar">✏️</button>
                                            <button type="button" class="excel-btn excel-btn-delete"
                                                    onclick="confirmarEliminar('/inventario/camaras/<%= cam.id %>/eliminar')"
                                                    title="Eliminar">🗑️</button>
                                        </div>
                                    </td>
                                </tr>
                                <tr id="edit-cam-<%= cam.id %>" style="display:none; background:#fffbeb;">
                                    <td colspan="7" style="padding:0;">
                                        <form action="/inventario/camaras/<%= cam.id %>/editar" method="POST"
                                              style="display:table; width:100%;">
                                            <div style="display:table-row;">
                                                <div style="display:table-cell; padding:8px 10px; width:14%;">
                                                    <input type="text" value="<%= cam.codigo %>" class="excel-cell-input" readonly>
                                                </div>
                                                <div style="display:table-cell; padding:8px 10px; width:14%;">
                                                    <input type="text" name="marca" value="<%= cam.marca || '' %>" class="excel-cell-input">
                                                </div>
                                                <div style="display:table-cell; padding:8px 10px; width:8%;">
                                                    <select name="dvr" class="excel-cell-select">
                                                    <% ['1','2','3'].forEach(d => { %>
                                                    <option value="<%= d %>" <%= (cam.dvr || '1') === d ? 'selected' : '' %>>DVR <%= d %></option>
                                                    <% }) %>
                                                    </select>
                                                </div>
                                                <div style="display:table-cell; padding:8px 10px; width:18%;">
                                                    <input type="text" name="ubicacion" value="<%= cam.ubicacion || '' %>" class="excel-cell-input">
                                                </div>
                                                <input type="hidden" name="piso" value="<%= cam.piso %>">
                                                <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                    <select name="estado" class="excel-cell-select" onchange="validarArchivado(this, 'camara', <%= cam.id %>)">
                                                        <% estados.forEach(e => { %>
                                                            <option value="<%= e %>" <%= cam.estado === e ? 'selected' : '' %>><%= e %></option>
                                                        <% }) %>
                                                    </select>
                                                </div>
                                                <div style="display:table-cell; padding:8px 10px; width:14%;">
                                                    <input type="text" name="observaciones" value="<%= cam.observaciones || '' %>" class="excel-cell-input">
                                                </div>
                                                <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                    <div class="excel-actions">
                                                        <button type="submit" class="excel-btn excel-btn-save" title="Guardar">✓</button>
                                                        <button type="button" class="excel-btn excel-btn-delete"
                                                                onclick="cancelarEdicion('edit-cam-<%= cam.id %>')" title="Cancelar">✕</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                <% } else { %>
                                <tr><td colspan="7" style="text-align:center; padding:40px; color:#a0aec0;">No hay cámaras registradas en el piso <%= p %></td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>

        <script>
            window.CODIGOS_CAMARA = <%- JSON.stringify(siguienteCodigoCamara) %>;
            window.PISO_CAMARA_INICIAL = <%- JSON.stringify(piso) %>;
        </script>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PANEL SENSORES                                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="tab-sensores" class="inventario-panel <%= tab === 'sensores' ? 'active' : '' %>">
            <div class="excel-toolbar">
                <div class="excel-search">
                    <input type="text" id="buscar-sensores"
                           placeholder="Buscar sensores..."
                           onkeyup="filtrarTabla('tabla-sensores', this.value)">
                </div>
                <button class="btn btn-success" onclick="abrirModal('modal-sensor')">
                    + Nuevo Sensor
                </button>
            </div>

            <div class="card" style="padding:0;">
                <div class="table-container">
                    <table class="table" id="tabla-sensores">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Equipo</th>
                                <th>Nomenclatura</th>
                                <th>Ubicación</th>
                                <th>Tecnología</th>
                                <th>Estado</th>
                                <th>Observaciones</th>
                                <th style="width:90px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (sensores && sensores.length > 0) { %>
                            <% sensores.forEach(s => { %>
                            <tr>
                                <td><strong><%= s.codigo %></strong></td>
                                <td><%= s.equipo %></td>
                                <td><%= s.nomenclatura %></td>
                                <td><%= s.ubicacion %></td>
                                <td><%= s.tecnologia %></td>
                                <td>
                                    <span class="badge <%= s.estado === 'Operativo' ? 'badge-success' : s.estado === 'Averiado' ? 'badge-danger' : s.estado === 'Deficiente' ? 'badge-warning' : s.estado === 'Pendiente revisión' ? 'badge-info' : 'badge-secondary' %>">
                                        <%= s.estado %>
                                    </span>
                                </td>
                                <td><%= s.observaciones || '—' %></td>
                                <td>
                                    <div class="excel-actions">
                                        <button type="button" class="excel-btn excel-btn-save"
                                                onclick="editarFila('edit-seg-<%= s.id %>')" title="Editar">✏️</button>
                                        <button type="button" class="excel-btn excel-btn-delete"
                                                onclick="confirmarEliminar('/inventario/sensores/<%= s.id %>/eliminar')"
                                                title="Eliminar">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                            <tr id="edit-seg-<%= s.id %>" style="display:none; background:#fffbeb;">
                                <td colspan="8" style="padding:0;">
                                    <form action="/inventario/sensores/<%= s.id %>/editar" method="POST"
                                          style="display:table; width:100%;">
                                        <div style="display:table-row;">
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <input type="text" value="<%= s.codigo %>" class="excel-cell-input" readonly>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:15%;">
                                                <input type="text" name="equipo" value="<%= s.equipo %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:15%;">
                                                <input type="text" name="nomenclatura" value="<%= s.nomenclatura %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:15%;">
                                                <input type="text" name="ubicacion" value="<%= s.ubicacion %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <select name="tecnologia" class="excel-cell-select">
                                                    <% ['Cableado','Inalámbrico'].forEach(t => { %>
                                                        <option value="<%= t %>" <%= s.tecnologia === t ? 'selected' : '' %>><%= t %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <select name="estado" class="excel-cell-select" onchange="validarArchivado(this, 'sensor', <%= s.id %>)">
                                                    <% estados.forEach(e => { %>
                                                        <option value="<%= e %>" <%= s.estado === e ? 'selected' : '' %>><%= e %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:11%;">
                                                <input type="text" name="observaciones" value="<%= s.observaciones || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <div class="excel-actions">
                                                    <button type="submit" class="excel-btn excel-btn-save" title="Guardar">✓</button>
                                                    <button type="button" class="excel-btn excel-btn-delete"
                                                            onclick="cancelarEdicion('edit-seg-<%= s.id %>')" title="Cancelar">✕</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="8" style="text-align:center; padding:40px; color:#a0aec0;">No hay sensores registrados</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PANEL PUNTOS DE RED                                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="tab-puntosred" class="inventario-panel <%= tab === 'puntosred' ? 'active' : '' %>">
            <div class="excel-toolbar">
                <div class="excel-search">
                    <input type="text" id="buscar-puntosred"
                           placeholder="Buscar puntos de red..."
                           onkeyup="filtrarTabla('tabla-puntosred', this.value)">
                </div>
                <button class="btn btn-success" onclick="abrirModal('modal-puntored')">
                    + Nuevo Punto de Red
                </button>
            </div>

            <div class="card" style="padding:0;">
                <div class="table-container">
                    <table class="table" id="tabla-puntosred">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Ubicación</th>
                                <th>Tipo de cable</th>
                                <th>Longitud</th>
                                <th>Uso</th>
                                <th>Estado</th>
                                <th>Observaciones</th>
                                <th style="width:90px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (puntosRed && puntosRed.length > 0) { %>
                            <% puntosRed.forEach(r => { %>
                            <tr>
                                <td><strong><%= r.codigo %></strong></td>
                                <td><%= r.ubicacion %></td>
                                <td><%= r.tipoCable %></td>
                                <td><%= r.longitud || '—' %></td>
                                <td><%= r.tipoUso %></td>
                                <td>
                                    <span class="badge <%= r.estado === 'Operativo' ? 'badge-success' : r.estado === 'Averiado' ? 'badge-danger' : r.estado === 'Deficiente' ? 'badge-warning' : r.estado === 'Pendiente revisión' ? 'badge-info' : 'badge-secondary' %>">
                                        <%= r.estado %>
                                    </span>
                                </td>
                                <td><%= r.observaciones || '—' %></td>
                                <td>
                                    <div class="excel-actions">
                                        <button type="button" class="excel-btn excel-btn-save"
                                                onclick="editarFila('edit-red-<%= r.id %>')" title="Editar">✏️</button>
                                        <button type="button" class="excel-btn excel-btn-delete"
                                                onclick="confirmarEliminar('/inventario/puntosred/<%= r.id %>/eliminar')"
                                                title="Eliminar">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                            <tr id="edit-red-<%= r.id %>" style="display:none; background:#fffbeb;">
                                <td colspan="8" style="padding:0;">
                                    <form action="/inventario/puntosred/<%= r.id %>/editar" method="POST"
                                          style="display:table; width:100%;">
                                        <div style="display:table-row;">
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <input type="text" value="<%= r.codigo %>" class="excel-cell-input" readonly>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:16%;">
                                                <input type="text" name="ubicacion" value="<%= r.ubicacion %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <select name="tipoCable" class="excel-cell-select">
                                                    <% ['Cat 5e','Cat 6','Cat 6a','Fibra óptica'].forEach(c => { %>
                                                        <option value="<%= c %>" <%= r.tipoCable === c ? 'selected' : '' %>><%= c %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <input type="text" name="longitud" value="<%= r.longitud || '' %>" class="excel-cell-input" placeholder="Ej: 10mtr">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <select name="tipoUso" class="excel-cell-select">
                                                    <% ['Datos','AP','Cámara','Ruta Enlace'].forEach(u => { %>
                                                        <option value="<%= u %>" <%= r.tipoUso === u ? 'selected' : '' %>><%= u %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:12%;">
                                                <select name="estado" class="excel-cell-select" onchange="validarArchivado(this, 'puntored', <%= r.id %>)">
                                                    <% estados.forEach(e => { %>
                                                        <option value="<%= e %>" <%= r.estado === e ? 'selected' : '' %>><%= e %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:16%;">
                                                <input type="text" name="observaciones" value="<%= r.observaciones || '' %>" class="excel-cell-input">
                                            </div>
                                            <div style="display:table-cell; padding:8px 10px; width:10%;">
                                                <div class="excel-actions">
                                                    <button type="submit" class="excel-btn excel-btn-save" title="Guardar">✓</button>
                                                    <button type="button" class="excel-btn excel-btn-delete"
                                                            onclick="cancelarEdicion('edit-red-<%= r.id %>')" title="Cancelar">✕</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="8" style="text-align:center; padding:40px; color:#a0aec0;">No hay puntos de red registrados</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PANEL ARCHIVADOS                                    -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="tab-archivados" class="inventario-panel <%= tab === 'archivados' ? 'active' : '' %>">
            <div class="excel-toolbar">
                <div class="excel-search">
                    <input type="text" id="buscar-archivados"
                           placeholder="Buscar archivados..."
                           onkeyup="filtrarTabla('tabla-archivados', this.value)">
                </div>
                <button class="btn btn-success" onclick="abrirModal('modal-seleccion-archivado')">
                    + Nuevo Archivado
                </button>
            </div>

            <p style="color:#8b95a8; font-size:0.85rem; margin:-10px 0 15px 0;">
                Equipos archivados temporalmente. Puedes restaurarlos a su categoría original cuando los necesites.
            </p>

            <div class="card" style="padding:0;">
                <div class="table-container">
                    <table class="table" id="tabla-archivados">
                        <thead>
                            <tr>
                                <th style="width:40px;"></th>
                                <th>Código / Nombre</th>
                                <th>Categoría</th>
                                <th>Detalle 1</th>
                                <th>Detalle 2</th>
                                <th>Detalle 3</th>
                                <th>Observaciones</th>
                                <th style="width:120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (archivados && archivados.length > 0) { %>
                            <% archivados.forEach(a => { %>
                            <tr>
                                <td style="text-align:center;">
                                    <i class="fas <%= a.icono %>" style="color:#8b95a8; font-size:0.9rem;"></i>
                                </td>
                                <td><strong><%= a.codigo %></strong><br><small style="color:#8b95a8;"><%= a.nombre %></small></td>
                                <td><span class="badge badge-info"><%= a.tipoLabel %></span></td>
                                <td><%= a.detalle1 %></td>
                                <td><%= a.detalle2 %></td>
                                <td><%= a.detalle3 %></td>
                                <td><%= a.observaciones || '—' %></td>
                                <td>
                                    <div class="excel-actions">
                                        <button type="button" class="excel-btn excel-btn-save"
                                                onclick="abrirModalRestaurar('<%= a.tipo %>', <%= a.id %>, '<%= a.codigo %>', '<%= a.tipoLabel %>')"
                                                title="Restaurar">🔄</button>
                                        <button type="button" class="excel-btn excel-btn-delete"
                                                onclick="confirmarEliminar('/inventario/<%= a.tipo === 'puntored' ? 'puntosred' : a.tipo + 's' %>/<%= a.id %>/eliminar')"
                                                title="Eliminar">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="8" style="text-align:center; padding:40px; color:#a0aec0;">No hay equipos archivados</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PANEL DOCUMENTOS                                    -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="tab-documentos" class="inventario-panel <%= tab === 'documentos' ? 'active' : '' %>">
            <div class="excel-toolbar">
                <div class="excel-search">
                    <input type="text" id="buscar-documentos"
                           placeholder="Buscar documentos..."
                           onkeyup="filtrarTabla('tabla-documentos', this.value)">
                </div>
                <button class="btn btn-success" onclick="abrirModal('modal-documento')">
                    + Subir Documento
                </button>
            </div>

            <p style="color:#8b95a8; font-size:0.85rem; margin:-10px 0 15px 0;">
                Actas de entrega, certificados y bitácoras escaneadas de las empresas contratistas.
            </p>

            <div class="card" style="padding:0;">
                <div class="table-container">
                    <table class="table" id="tabla-documentos">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Empresa</th>
                                <th>Tipo</th>
                                <th>Categoría</th>
                                <th>Fecha del documento</th>
                                <th style="width:140px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (documentos && documentos.length > 0) { %>
                            <% documentos.forEach(d => { %>
                            <tr>
                                <td><strong><%= d.titulo %></strong></td>
                                <td><%= d.empresa %></td>
                                <td><span class="badge badge-info"><%= d.tipoDocumento %></span></td>
                                <td><%= d.categoria %></td>
                                <td><%= d.fechaDocumento ? helpers.formatearFecha(d.fechaDocumento) : '—' %></td>
                                <td>
                                    <div class="excel-actions">
                                        <a href="/uploads/documentos/<%= d.archivo %>" target="_blank"
                                           class="excel-btn excel-btn-save" title="Ver documento">👁️</a>
                                        <button type="button" class="excel-btn excel-btn-delete"
                                                onclick="confirmarEliminar('/inventario/documentos/<%= d.id %>/eliminar')"
                                                title="Eliminar">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="6" style="text-align:center; padding:40px; color:#a0aec0;">No hay documentos subidos aún</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

            </div><!-- /.inventario-content -->
        </div><!-- /.inventario-layout -->
    </div><!-- /.container -->

    <%- include('partials/footer') %>
</div><!-- /.main-content -->

<!-- ═══════════════════════════════════════════════════════ -->
<!-- MODAL SELECCIONAR CATEGORÍA ARCHIVADO                  -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modal-seleccion-archivado">
    <div class="modal-content" style="max-width:400px;">
        <div class="modal-header">
            <h2>Nuevo Archivado</h2>
            <button class="modal-close" onclick="cerrarModal('modal-seleccion-archivado')">×</button>
        </div>
        <div class="modal-body">
            <p style="color:#64748b; margin-bottom:20px;">Selecciona la categoría del equipo que deseas archivar:</p>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <button type="button" class="btn btn-secondary" style="justify-content:flex-start; gap:12px; padding:14px 18px; font-size:1rem;"
                        onclick="cerrarModal('modal-seleccion-archivado'); abrirModal('modal-computadora'); preseleccionarArchivado('modal-computadora');">
                    <i class="fas fa-desktop"></i> Computadora
                </button>
                <button type="button" class="btn btn-secondary" style="justify-content:flex-start; gap:12px; padding:14px 18px; font-size:1rem;"
                        onclick="cerrarModal('modal-seleccion-archivado'); abrirModal('modal-periferico'); preseleccionarArchivado('modal-periferico');">
                    <i class="fas fa-keyboard"></i> Periférico
                </button>
                <button type="button" class="btn btn-secondary" style="justify-content:flex-start; gap:12px; padding:14px 18px; font-size:1rem;"
                        onclick="cerrarModal('modal-seleccion-archivado'); abrirModal('modal-camara'); preseleccionarArchivado('modal-camara');">
                    <i class="fas fa-video"></i> Cámara
                </button>
                <button type="button" class="btn btn-secondary" style="justify-content:flex-start; gap:12px; padding:14px 18px; font-size:1rem;"
                        onclick="cerrarModal('modal-seleccion-archivado'); abrirModal('modal-sensor'); preseleccionarArchivado('modal-sensor');">
                    <i class="fas fa-shield-alt"></i> Sensor
                </button>
                <button type="button" class="btn btn-secondary" style="justify-content:flex-start; gap:12px; padding:14px 18px; font-size:1rem;"
                        onclick="cerrarModal('modal-seleccion-archivado'); abrirModal('modal-puntored'); preseleccionarArchivado('modal-puntored');">
                    <i class="fas fa-network-wired"></i> Punto de Red
                </button>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="cerrarModal('modal-seleccion-archivado')">Cancelar</button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- MODAL RESTAURAR ARCHIVADO                              -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modal-restaurar">
    <div class="modal-content" style="max-width:450px;">
        <div class="modal-header">
            <h2>Restaurar Equipo</h2>
            <button class="modal-close" onclick="cerrarModal('modal-restaurar')">×</button>
        </div>
        <form id="form-restaurar" method="POST">
            <div class="modal-body">
                <p style="color:#64748b; margin-bottom:20px;">
                    Estás a punto de restaurar <strong id="restaurar-nombre"></strong> 
                    (<span id="restaurar-tipo"></span>) a su categoría original.
                </p>
                <div class="form-group">
                    <label class="form-label">Nuevo estado</label>
                    <select name="estado" class="form-control">
                        <option value="Operativo" selected>Operativo</option>
                        <option value="Deficiente">Deficiente</option>
                        <option value="Averiado">Averiado</option>
                        <option value="Desconectado">Desconectado</option>
                        <option value="Pendiente revisión">Pendiente revisión</option>
                    </select>
                </div>
                <div class="form-group" id="campo-ubicacion-restaurar">
                    <label class="form-label">Nueva ubicación / Asignación</label>
                    <input type="text" name="ubicacion" class="form-control" placeholder="Ej: Oficina 2, Caja 3...">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cerrarModal('modal-restaurar')">Cancelar</button>
                <button type="submit" class="btn btn-success">Restaurar</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- MODAL NUEVA COMPUTADORA                                  -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modal-computadora">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Nueva Computadora</h2>
            <button class="modal-close" onclick="cerrarModal('modal-computadora')">×</button>
        </div>
        <form action="/inventario/computadoras" method="POST">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nombre / Código *</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ej: PC-CAJA-01">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fabricante</label>
                        <input type="text" name="fabricante" class="form-control" placeholder="Ej: HP, Dell, Lenovo">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Modelo</label>
                        <input type="text" name="modelo" class="form-control" placeholder="Ej: ProDesk 400 G7">
                    </div>
                    <div class="form-group">
                        <label class="form-label">N° de Serie</label>
                        <input type="text" name="numeroSerie" class="form-control">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Procesador</label>
                    <input type="text" name="procesador" class="form-control" placeholder="Ej: Intel Core i5-10400">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">RAM (GB)</label>
                        <input type="number" name="ramGb" class="form-control" min="1" placeholder="8">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Disco SSD (GB)</label>
                        <input type="number" name="discoSsdGb" class="form-control" min="1" placeholder="256">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-control">
                            <% estados.forEach(e => { %><option value="<%= e %>"><%= e %></option><% }) %>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Observaciones</label>
                    <textarea name="observaciones" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cerrarModal('modal-computadora')">Cancelar</button>
                <button type="submit" class="btn btn-success">Crear</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- MODAL NUEVO PERIFÉRICO                                   -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modal-periferico">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Nuevo Periférico</h2>
            <button class="modal-close" onclick="cerrarModal('modal-periferico')">×</button>
        </div>
        <form action="/inventario/perifericos" method="POST">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Código <span style="color:#8b95a8; font-weight:400;">(opcional)</span></label>
                        <input type="text" name="codigo" class="form-control"
                               placeholder="<%= siguienteCodigoPeriferico %>"
                               style="color:#a0aec0; font-style:italic;"
                               onfocus="this.style.color='#2c3e50'; this.style.fontStyle='normal'; if(this.value==='') this.value='<%= siguienteCodigoPeriferico %>';"
                               onblur="if(this.value==='<%= siguienteCodigoPeriferico %>' || this.value==='') { this.value=''; this.style.color='#a0aec0'; this.style.fontStyle='italic'; }">
                        <div class="form-hint" style="font-size:0.8rem; color:#8b95a8; margin-top:4px;">
                            Próximo código disponible: <strong><%= siguienteCodigoPeriferico %></strong>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Categoría *</label>
                        <select name="categoria" class="form-control" required>
                            <option value="Teclado">Teclado</option>
                            <option value="Mouse">Mouse</option>
                            <option value="Monitor">Monitor</option>
                            <option value="UPS">UPS</option>
