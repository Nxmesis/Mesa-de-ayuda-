<!-- MODAL NUEVA CÁMARA                                       -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modal-camara">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Nueva Cámara — Piso <%= piso %></h2>
            <button class="modal-close" onclick="cerrarModal('modal-camara')">×</button>
        </div>
        <form action="/inventario/camaras" method="POST">
            <div class="modal-body">
                <input type="hidden" name="piso" value="<%= piso %>">
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Código <span style="color:#8b95a8; font-weight:400;">(opcional)</span></label>
                        <input type="text" 
                               name="codigo" 
                               class="form-control" 
                               placeholder="<%= siguienteCodigoCamara[piso] %>"
                               style="color: #a0aec0; font-style: italic;"
                               onfocus="this.style.color='#2c3e50'; this.style.fontStyle='normal'; if(this.value==='') this.value='<%= siguienteCodigoCamara[piso] %>';"
                               onblur="if(this.value==='<%= siguienteCodigoCamara[piso] %>' || this.value==='') { this.value=''; this.style.color='#a0aec0'; this.style.fontStyle='italic'; }">
                        <div class="form-hint" style="font-size: 0.8rem; color: #8b95a8; margin-top: 4px;">
                            Próximo código: <strong><%= siguienteCodigoCamara[piso] %></strong>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-control">
                            <option value="Operativo">Operativo</option>
                            <option value="Deficiente">Deficiente</option>
                            <option value="Averiado">Averiado</option>
                            <option value="Desconectado">Desconectado</option>
                            <option value="Archivado">Archivado</option>
                            <option value="Pendiente revisión">Pendiente revisión</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Marca</label>
                        <input type="text" name="marca" class="form-control"
                               placeholder="Ej: Hikvision, Dahua, Ezviz">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">DVR</label>
                    <select name="dvr" class="form-control">
                        <option value="1">DVR 1</option>
                        <option value="2">DVR 2</option>
                        <option value="3">DVR 3</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Ubicación en Almacén *</label>
                    <input type="text" name="ubicacion" class="form-control" required
                           placeholder="Ej: Entrada principal, Pasillo A, Bodega trasera">
                </div>
                <div class="form-group">
                    <label class="form-label">Observaciones</label>
                    <textarea name="observaciones" class="form-control" rows="2"
                              placeholder="Ej: Cámara con visión nocturna, ángulo 90°"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        onclick="cerrarModal('modal-camara')">Cancelar</button>
                <button type="submit" class="btn btn-success">Crear</button>
            </div>
        </form>
    </div>
</div>

