                        <input type="text" name="empresa" class="form-control" required placeholder="Ej: TECNOSEGUR SAS">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tipo de documento</label>
                        <select name="tipoDocumento" class="form-control">
                            <option value="Acta">Acta</option>
                            <option value="Certificado">Certificado</option>
                            <option value="Bitácora">Bitácora</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Categoría relacionada</label>
                        <select name="categoria" class="form-control">
                            <option value="General">General</option>
                            <option value="Camaras">Cámaras</option>
                            <option value="Sensores">Sensores</option>
                            <option value="PuntosRed">Puntos de Red</option>
                            <option value="Computadoras">Computadoras</option>
                            <option value="Perifericos">Periféricos</option>
