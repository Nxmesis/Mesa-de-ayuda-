<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Reporte de Gestión de Tickets</title>
  <style>
    <%- cssInline %>
  </style>
</head>
<body>

  <!-- ═══════ ENCABEZADO ═══════ -->
  <header class="report-header">
    <div class="report-header-left">
      <% if (logoBase64) { %>
      <img src="<%= logoBase64 %>" alt="Almacén El Melao" class="report-logo">
      <% } %>
      <div class="report-company">
        <h1>ALMACÉN <span>EL MELAO</span></h1>
        <p>Líder en Precios Bajos</p>
      </div>
    </div>
    <div class="report-header-right">
      <span class="report-badge">Informe de Gestión</span>
      <div class="report-date">
        <strong>Período:</strong> <%= periodo %><br>
        <strong>Generado:</strong> <%= fechaGeneracion %>
      </div>
    </div>
  </header>

  <!-- ═══════ TÍTULO ═══════ -->
  <div class="report-title-section">
    <h2>Reporte de Gestión de Tickets — Mesa de Ayuda</h2>
    <p>Resumen ejecutivo del sistema de gestión de solicitudes y soporte </p>
  </div>

  <!-- ═══════ RESUMEN EJECUTIVO ═══════ -->
  <div class="report-summary">
    <h3>Resumen Ejecutivo</h3>
    <p>
      Durante el período <strong><%= periodo %></strong> se han registrado <strong><%= stats.total %></strong> tickets en el sistema.
      De estos, <strong><%= stats.pendientes %></strong> están pendientes,
      <strong><%= stats.enProceso %></strong> en proceso,
      <strong><%= stats.solucionados %></strong> han sido solucionados y
      <strong><%= stats.cerrados %></strong> cerrados.
      La tasa de resolución se sitúa en el <strong><%= stats.tasaResolucion %>%</strong>,
      reflejando el desempeño del personal encargado.
    </p>
  </div>

  <!-- ═══════ KPIs PRINCIPALES ═══════ -->
  <div class="report-section">
    <div class="report-section-title">
      Indicadores Clave de Desempeño (KPIs)
    </div>
    <div class="report-kpis">
      <div class="report-kpi kpi-total">
        <div class="report-kpi-value"><%= stats.total %></div>
        <div class="report-kpi-label">Total Tickets</div>
      </div>
      <div class="report-kpi kpi-pendiente">
        <div class="report-kpi-value" style="color:#d69e2e"><%= stats.pendientes %></div>
        <div class="report-kpi-label">Pendientes</div>
      </div>
      <div class="report-kpi kpi-proceso">
        <div class="report-kpi-value" style="color:#3182ce"><%= stats.enProceso %></div>
        <div class="report-kpi-label">En Proceso</div>
      </div>
      <div class="report-kpi kpi-solucionado">
        <div class="report-kpi-value" style="color:#38a169"><%= stats.solucionados %></div>
        <div class="report-kpi-label">Solucionados</div>
      </div>
      <div class="report-kpi kpi-cerrado">
        <div class="report-kpi-value" style="color:#718096"><%= stats.cerrados %></div>
        <div class="report-kpi-label">Cerrados</div>
      </div>
      <div class="report-kpi kpi-tasa">
        <div class="report-kpi-value" style="color:#2ecc71"><%= stats.tasaResolucion %>%</div>
        <div class="report-kpi-label">Tasa Resolución</div>
      </div>
    </div>
  </div>

  <!-- ═══════ TENDENCIA (Gráfico CSS) ═══════ -->
  <div class="report-section">
    <div class="report-section-title">
      Tendencia de Tickets — Últimos 7 Días
    </div>
    <%
      const maxDia = Math.max(...porDia, 1);
      const diasSemana = diasLabels || ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
    %>
    <div class="report-chart">
      <% for (let i = 0; i < porDia.length; i++) { %>
      <div class="report-chart-bar">
        <div class="report-chart-bar-value"><%= porDia[i] %></div>
        <div class="report-chart-bar-fill" style="height: <%= (porDia[i] / maxDia * 100) || 4 %>%"></div>
        <div class="report-chart-bar-label"><%= diasSemana[i] || 'Día ' + (i+1) %></div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- ═══════ GRID DE 2 COLUMNAS ═══════ -->
  <div class="report-grid-2">

    <!-- Tickets por Categoría — color específico por categoría -->
    <div class="report-section">
      <div class="report-section-title">
        Tickets por Categoría
      </div>
      <% if (porCategoria && porCategoria.length > 0) { %>
      <table class="report-table">
        <thead>
          <tr><th>Categoría</th><th class="text-right">Total</th><th class="text-right">%</th></tr>
        </thead>
        <tbody>
          <% porCategoria.forEach((c) => { %>
          <% const colorCat = CATEGORIA_COLORS[c.nombre] || '#95a5a6'; %>
          <tr>
            <td>
              <span style="display:inline-flex;align-items:center;gap:6px;">
                <span style="width:12px;height:12px;border-radius:50%;background:<%= colorCat %>;display:inline-block;"></span>
                <%= c.nombre %>
              </span>
            </td>
            <td class="text-right font-mono"><strong><%= c._count.tickets %></strong></td>
            <td class="text-right">
              <div class="report-bar">
                <div class="report-bar-track"><div class="report-bar-fill" style="background:<%= colorCat %>;width:<%= stats.total>0?Math.round(c._count.tickets*100/stats.total):0 %>%"></div></div>
                <span class="report-bar-text"><%= stats.total>0?Math.round(c._count.tickets*100/stats.total):0 %>%</span>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p style="color:#8b95a8;font-size:9pt;padding:10px;">Sin datos de categorías.</p>
      <% } %>
    </div>

    <!-- Tickets por Prioridad — color específico por prioridad -->
    <div class="report-section">
      <div class="report-section-title">
        Tickets por Prioridad
      </div>
      <% if (porPrioridad && porPrioridad.length > 0) { %>
      <table class="report-table">
        <thead>
          <tr><th>Prioridad</th><th class="text-right">Total</th><th class="text-right">%</th></tr>
        </thead>
        <tbody>
          <% porPrioridad.forEach(p => { %>
          <% const colorPrio = PRIORIDAD_COLORS[p.prioridad] || '#95a5a6'; %>
          <tr>
            <td>
              <span class="report-badge-pill" style="background:<%= colorPrio %>1a;color:<%= colorPrio %>;"><%= p.prioridad %></span>
            </td>
            <td class="text-right font-mono"><strong><%= p._count.id %></strong></td>
            <td class="text-right">
              <div class="report-bar">
                <div class="report-bar-track"><div class="report-bar-fill" style="background:<%= colorPrio %>;width:<%= stats.total>0?Math.round(p._count.id*100/stats.total):0 %>%"></div></div>
                <span class="report-bar-text"><%= stats.total>0?Math.round(p._count.id*100/stats.total):0 %>%</span>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p style="color:#8b95a8;font-size:9pt;padding:10px;">Sin datos de prioridad.</p>
      <% } %>
    </div>
  </div>

  <!-- ═══════ LISTADO DETALLADO DE TICKETS (info + solución) ═══════ -->
  <div class="report-section">
    <div class="report-section-title">
      Detalle de Tickets del Período (<%= tickets.length %>)
    </div>

    <% if (tickets && tickets.length > 0) { %>
    <div class="report-tickets-list">
      <% tickets.forEach(t => { %>
      <% const colorPrio = PRIORIDAD_COLORS[t.prioridad] || '#95a5a6'; %>
      <% const pillEstado = {
           Pendiente: 'pill-pendiente', EnProceso: 'pill-proceso',
           EsperandoInfo: 'pill-cerrado', Solucionado: 'pill-solucionado',
           Cerrado: 'pill-cerrado',
         }[t.estado] || 'pill-cerrado'; %>
      <div class="report-ticket-item">
        <div class="report-ticket-head">
          <div>
            <span class="report-ticket-numero"><%= t.numeroTicket %></span>
            <span class="report-ticket-titulo"><%= t.titulo %></span>
          </div>
          <div class="report-ticket-meta">
            <span class="report-badge-pill" style="background:<%= colorPrio %>1a;color:<%= colorPrio %>;"><%= t.prioridad %></span>
            <span class="report-badge-pill <%= pillEstado %>"><%= helpers.textoEstado(t.estado) %></span>
          </div>
        </div>

        <div class="report-ticket-info">
          <span><strong>Solicitante:</strong> <%= t.usuario ? t.usuario.nombre : '—' %><% if (t.usuario && t.usuario.area) { %> (<%= t.usuario.area %>)<% } %></span>
          <span><strong>Categoría:</strong> <%= t.categoria ? t.categoria.nombre : 'Sin categoría' %></span>
          <span><strong>Asignado a:</strong> <%= t.tecnico ? t.tecnico.nombre : 'Sin asignar' %></span>
          <span><strong>Creado:</strong> <%= helpers.formatearFecha(t.fechaCreacion) %></span>
          <% if (t.fechaCierre) { %>
          <span><strong>Cerrado:</strong> <%= helpers.formatearFecha(t.fechaCierre) %></span>
          <% } %>
        </div>

        <div class="report-ticket-block">
          <div class="report-ticket-block-label">Descripción</div>
          <div class="report-ticket-block-text"><%= t.descripcion || 'Sin descripción' %></div>
        </div>

        <div class="report-ticket-block">
          <div class="report-ticket-block-label">Solución</div>
          <% if (t.solucion) { %>
          <div class="report-ticket-block-text"><%= t.solucion %></div>
          <% } else { %>
          <div class="report-ticket-sin-solucion">Sin solución registrada</div>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
      <p style="color:#8b95a8;font-size:9pt;padding:10px;">No hay tickets registrados en este período.</p>
    <% } %>
  </div>

  <!-- ═══════ NOTAS Y PIE ═══════ -->
  <div class="report-footer-note">
    <strong>Mesa de Ayuda Interna — Almacén El Melao</strong><br>
    Este informe fue generado automáticamente por el sistema de gestión de tickets.<br>
    Para consultas contactar al área de Tecnología.<br>
    <em>Documento confidencial — Uso interno exclusivo</em>
  </div>

</body>
</html>